{
  "ConnectionStrings": {
    "ThermoTwin": "Data Source=App_Data/thermotwin.db"
  },
  "ThermoTwin": {
    "AutoStartDemo": true,
    "SeedExperiments": true,
    "SnapshotEverySteps": 6
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
