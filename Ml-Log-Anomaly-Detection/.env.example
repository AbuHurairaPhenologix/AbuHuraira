# Copy to .env and replace every CHANGE_ME value, or generate random values with:
#   python scripts/setup/generate_env.py
# .env is git-ignored. Never commit real credentials.

# PostgreSQL
POSTGRES_DB=anomaly_detection
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_HOST_PORT=5433

# OpenSearch (development: security plugin disabled, loopback-only port)
OPENSEARCH_HOST_PORT=9200

# Backend → ML service short-lived service tokens (HS256, >= 32 characters, shared by backend and ml-service)
ML_SERVICE_TOKEN_SIGNING_KEY=CHANGE_ME_at_least_32_characters_service_token_key

# Dashboard user tokens (development issuer, >= 32 characters)
AUTH_SIGNING_KEY=CHANGE_ME_at_least_32_characters_user_token_key

# Demo identities: engineer (Engineer role) and admin (Administrator role)
DEMO_ENGINEER_PASSWORD=CHANGE_ME_engineer_password
DEMO_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Service credential for event producers (X-Api-Key on POST /api/v1/events)
INGESTION_API_KEY=CHANGE_ME_ingestion_api_key

# Behaviour
ASPNETCORE_ENVIRONMENT=Development
MODEL_BOOTSTRAP_ENABLED=true
DEMO_SCENARIOS_ENABLED=true
WINDOW_SIZE_MINUTES=5

# Host ports (bound to 127.0.0.1)
BACKEND_HOST_PORT=5080
FRONTEND_HOST_PORT=8081
