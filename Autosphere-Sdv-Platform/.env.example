# AutoSphere environment template.
# Copy to `.env` (git-ignored) and replace every value before using the stack anywhere but your own machine.
#   cp .env.example .env
# All values below are EXAMPLES for a local demo, not secrets of any real deployment.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=autosphere
POSTGRES_USER=autosphere
POSTGRES_PASSWORD=change-me-local-postgres

# --- API ---------------------------------------------------------------------
# HMAC key for JWT access tokens, at least 32 characters. Generate e.g. with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-value-of-at-least-32-chars

# Demo users created on first start (username: admin / engineer / viewer).
# Requirements: >= 12 characters, upper case, lower case, digit and symbol.
SEED_ADMIN_PASSWORD=Admin#AutoSphere2026
SEED_ENGINEER_PASSWORD=Engineer#AutoSphere2026
SEED_VIEWER_PASSWORD=Viewer#AutoSphere2026

# Fault injection is a test-harness feature. Keep it false outside simulation/demo environments.
FAULT_INJECTION_ENABLED=true

# --- Vehicle gateway / ECU simulation ----------------------------------------
# Shared secret of the simulated UDS SecurityAccess (seed/key) algorithm.
SECURITY_ACCESS_SECRET=change-me-simulated-security-access

# --- Published ports ---------------------------------------------------------
API_PORT=5080
WEB_PORT=8080
MQTT_PORT=1883
# Host ports for running the API/gateway outside Docker against the containers.
POSTGRES_PORT=5432
REDIS_PORT=6379
