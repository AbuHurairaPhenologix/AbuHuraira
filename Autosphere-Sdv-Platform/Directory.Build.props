<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1848/CA1873: LoggerMessage source generators are not required for a prototype;
         CA2007: ConfigureAwait is irrelevant in ASP.NET Core / generic host apps;
         CA1711/CA1716/CA1720: automotive naming (e.g. "Ecu...Status", "Byte") is intentional;
         CA1515: public types are needed for testability across assemblies. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1711;CA1716;CA1720;CA1515;CA1062;CA1303;CA1031;CA1819;CA1305;CA1307;CA1310;CA1309;CA1724;CA1034;CA1032;CA1064;CA2225;CA1812;CA1859;CA1822;CA5394;CA1028;CA1008;CA1027;CA2227;CA1002;CA1056;CA1054;CA1055;CA1308;CA1806</NoWarn>
    <Authors>AutoSphere contributors</Authors>
    <Product>AutoSphere</Product>
    <Copyright>Copyright (c) 2026 AutoSphere contributors</Copyright>
  </PropertyGroup>
</Project>
