{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}" } }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSql"
  },
  "ConnectionStrings": {
    "AutoSphere": "",
    "Redis": ""
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "autosphere"
  },
  "Jwt": {
    "Issuer": "autosphere",
    "Audience": "autosphere-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Telemetry": {
    "SamplingIntervalSeconds": 1,
    "RetentionDays": 7,
    "MaxHistoryHours": 24
  },
  "Diagnostics": {
    "ResponseTimeoutSeconds": 20
  },
  "Ota": {
    "HealthCheckSeconds": 8,
    "DeploymentTimeoutMinutes": 5,
    "MaxPackageSizeBytes": 1048576,
    "Signing": {
      "PrivateKeyPath": "/run/secrets/ota-signing-private.pem",
      "PublicKeyPath": "/keys/ota-signing-public.pem",
      "GenerateIfMissing": false
    }
  },
  "Health": {
    "BatteryTemperatureWarningC": 50,
    "BatteryTemperatureCriticalC": 60,
    "MotorTemperatureWarningC": 110,
    "MotorTemperatureCriticalC": 130,
    "StaleTelemetrySeconds": 10,
    "OfflineAfterSeconds": 30
  },
  "FaultInjection": {
    "Enabled": false
  },
  "Seed": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  }
}
